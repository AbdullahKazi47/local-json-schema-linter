{
  "title": "Person",
  "type": "object",
  "required": ["name", "age", "tags"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "age": {"type": "integer", "minimum": 0},
    "email": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$"},
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "address": {"$ref": "#/definitions/address"}
  },
  "definitions": {
    "address": {
      "type": "object",
      "required": ["city"],
      "properties": {
        "city": {"type": "string"},
        "zip": {"type": "string", "pattern": "^[0-9]{5}$"}
      }
    }
  }
}
